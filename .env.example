# Bu dosyanın adını .env yap ve en az BİR anahtar doldur (hepsi ücretsiz alınabilir).
# Anahtarları arayüzdeki Ayarlar > Modeller ekranından da girebilirsin.
# .env dosyası GitHub'a gitmez (.gitignore).

GEMINI_API_KEY=         # https://aistudio.google.com/apikey
GROQ_API_KEY=           # https://console.groq.com/keys
OPENROUTER_API_KEY=     # https://openrouter.ai/keys  (":free" modeller)
MISTRAL_API_KEY=        # https://console.mistral.ai/api-keys
CEREBRAS_API_KEY=       # https://cloud.cerebras.ai
XAI_API_KEY=            # https://console.x.ai  (Grok — ücretli kredi gerekebilir)

# Yerel/internetsiz model: Ollama kur, "ollama pull qwen2.5" çalıştır. Anahtar gerekmez.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Başka OpenAI uyumlu sunucu (LM Studio vb.)
# CUSTOM_BASE_URL=http://localhost:1234/v1
# CUSTOM_API_KEY=

# Model adını elle sabitlemek istersen (boşsa otomatik en iyisi seçilir):
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# Gmail + Google Takvim (Ayarlar > Bağlantılar'da adım adım anlatılıyor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Akıllı ev: Home Assistant (Hue, Xiaomi, Tuya, Sonoff, klima, TV...)
HA_URL=
HA_TOKEN=

# 3D yazıcı (OctoPrint)
OCTOPRINT_URL=
OCTOPRINT_KEY=

# Telegram (dünyanın her yerinden aynı beyin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# --- İsteğe bağlı ücretsiz servisler ---
# Uydudan canlı yangın noktaları (NASA FIRMS): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Canlı gemi konumları (AIS): https://aisstream.io (GitHub ile giriş → API key)
AISSTREAM_KEY=
# Resim üretimi yedeği (Hugging Face FLUX, ücretsiz): https://huggingface.co/settings/tokens
HF_TOKEN=
# Pollinations (resim üretimi anahtarsız çalışır; anahtar daha yüksek limit verir): https://auth.pollinations.ai
POLLINATIONS_TOKEN=
# OBS Studio uzaktan kontrol (Araçlar > WebSocket Sunucu Ayarları > parola)
OBS_PASSWORD=
# OpenAI Whisper (isteğe bağlı; Groq zaten ücretsiz konuşma tanıma sağlar)
OPENAI_API_KEY=

# Telefondan / diğer bilgisayarlardan erişim anahtarı (start-lan.bat otomatik üretir)
JARVIS_TOKEN=
